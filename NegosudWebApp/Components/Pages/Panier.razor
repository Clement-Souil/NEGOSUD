@page "/panier"
@using NegosudWebApp.Models
@using NegosudWebApp.Services
@inject ShoppingCartService CartService


<h1>Votre Panier</h1>

@if (CartService.Cart.Items.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Article</th>
                <th>Quantité</th>
                <th>Prix Unitaire</th>
                <th>Prix Total</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in CartService.Cart.Items)
            {
                <tr>
                    <td>@article.ProductName</td>
                    <td>@article.Quantity</td>
                    <td>@($"{article.Price} €")</td>
                    <td>@($"{article.Price * article.Quantity} €")</td>
                    <td>
                        <button class="btn btn-danger">Supprimer</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Total : @($"{CartService.Cart.TotalPrice} €")</h3>
    <button class="btn btn-success">Commander</button>
}
else
{
    <p>Votre panier est vide.</p>
}

@code {

    private bool _isLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("Chargement du panier...");
            await CartService.LoadCartAsync();
            _isLoaded = true;
            StateHasChanged(); // 🔄 Force un nouveau rendu après chargement des données

            // Ajout d'éléments de test UNIQUEMENT si le panier est vide
            if (!CartService.Cart.Items.Any())
            {
                var cartItem1 = new CartItem
                    {
                        ProductId = 1,
                        ProductName = "Gros et Petit Manseng",
                        Price = 7,
                        Quantity = 3
                    };

                var cartItem2 = new CartItem
                    {
                        ProductId = 10,
                        ProductName = "Grand Vintage Rosé",
                        Price = 9.5M,
                        Quantity = 2
                    };

                await CartService.AddToCartAsync(cartItem1);
                await CartService.AddToCartAsync(cartItem2);
                await CartService.SaveCartAsync();

                Console.WriteLine("Articles ajoutés au panier !");
            }
        }
    }


}
