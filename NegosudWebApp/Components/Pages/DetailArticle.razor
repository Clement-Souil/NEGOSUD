@page "/detailarticle/{id:int}"
@using NegosudWebApp.Services
@using NegosudLibrary.DTO
@using NegosudWebApp.Models 
@inject HttpClientService ArticlesService
@inject PanierModel Panier
@rendermode InteractiveServer

<PageTitle>Détail article</PageTitle>

@if (erreurMessage != null)
{
        <p style="color: red; text-align:center;">Erreur : @erreurMessage</p>
}
else if (article == null)
{
        <p style="text-align:center;">Chargement des informations de l'article...</p>
}
else
{
        <div class="article-detail-container">
            <!-- Image à gauche -->
            <div class="article-image">
                <img src="bootstrap/PhotosArticles/domaine-uby-gros-petit-manseng-gascogne.png" alt="@article.Nom" class="article-image" />
            </div>

            <!-- Détails à droite -->
            <div class="article-details">
                <h2>@article.Nom (@article.Annee)</h2>
                <p class="article-type"><strong>Type :</strong> @article.Famille</p>
                <p><strong>Degré d'alcool :</strong> @article.Degre%</p>  
                <p><strong>Volume :</strong> @article.Volume L</p>
                <p><strong>Quantité disponible :</strong> @article.Quantite</p>

                <!-- Sélection quantité -->
                <div class="quantity-selector">
                    <label for="quantity">Quantité :</label>
                    <input type="number" id="quantity" min="1" @bind="quantiteSelectionnee" />
                </div>

                <!-- Prix -->
                <p class="article-price"><strong>Prix :</strong> @($"{prixTotal} €")</p>

                <!-- Bouton ajouter au panier -->
                <button class="add-to-cart" @onclick="AjouterAuPanier">Ajouter au panier</button>
            </div>
        </div>

        <!-- Description en bas -->
        <div class="article-description">
            <h3>Description</h3>
            <p>@article.Description</p>
        </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private ArticleDTO? article;
    private string? erreurMessage;
    private int quantiteSelectionnee = 1;
    private decimal prixTotal => (decimal)(article?.PrixVente ?? 0) * quantiteSelectionnee;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            article = await ArticlesService.GetArticleByIdAsync(Id);

            if (article == null)
            {
                erreurMessage = "L'article n'existe pas.";
            }
        }
        catch (Exception ex)
        {
            erreurMessage = $"Erreur lors du chargement de l'article : {ex.Message}";
            Console.WriteLine($"[Blazor ERROR] {ex}");
        }
    }

    private void AjouterAuPanier()
    {
        if (article == null)
        {
            Console.WriteLine("[ERREUR] Impossible d'ajouter un article nul au panier.");
            return;
        }

        // Création d'un nouvel article pour le panier
        var articlePanier = new ArticlePanier
            {
                Id = article.Id,
                Nom = article.Nom,
                PrixUnitaire = (decimal)article.PrixVente,
                Quantite = quantiteSelectionnee
            };

        // Ajouter l'article au panier
        Panier.AjouterArticle(articlePanier);
        Console.WriteLine($"✅ {quantiteSelectionnee} x {article.Nom} ajouté(s) au panier.");
    }
}
